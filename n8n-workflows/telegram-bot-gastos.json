      "id": "http-pendientes",
      "name": "API - Pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 600]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\n\nif (!data || data.length === 0) {\n  return [{ json: { text: '✅ No tienes pagos próximos en los siguientes 5 días.' } }];\n}\n\nlet msg = '⏰ *Pagos próximos (5 días):*\\n\\n';\nfor (const g of data) {\n  const monto = g.monto ? `$${g.monto}` : 'S/M';\n  msg += `📌 *${g.servicio}* - Día ${g.dia_pago} - ${monto}\\n`;\n}\n\nreturn [{ json: { text: msg } }];"
      },
