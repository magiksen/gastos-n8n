    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst caption = msg.caption || '';\nconst nombre = caption.replace('/comprobante ', '').trim();\n\nif (!nombre) {\n  return [{ json: { error: true, text: '❌ Envía la foto con el caption:\\n/comprobante NombreServicio' } }];\n}\n\n// Get the largest photo\nconst photos = msg.photo;\nconst photo = photos[photos.length - 1];\n\nreturn [{ json: { error: false, nombre: nombre, file_id: photo.file_id } }];"
      },
