    {
      "parameters": {
        "jsCode": "return [{ json: { text: '🤖 *Bot de Gastos*\\n\\nComandos disponibles:\\n\\n📋 /ver - Ver lista de gastos del mes\\n➕ /agregar Servicio,dia,monto - Agregar gasto\\n➖ /quitar Servicio - Eliminar gasto\\n✅ /pagar Servicio - Marcar como pagado\\n⏰ /pendientes - Ver pagos próximos\\n📅 /generar - Generar gastos del mes actual\\n📸 Envía una foto con caption /comprobante Servicio\\n❓ /help - Ver esta ayuda' } }];"
      },
