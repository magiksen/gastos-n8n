        "jsCode": "const text = $input.first().json.message.text;\n// Formato: /pagar NombreServicio\nconst nombre = text.replace('/pagar ', '').trim();\n\nif (!nombre) {\n  return [{ json: { error: true, text: '❌ Indica el nombre del servicio.\\nUsa: /pagar Netflix' } }];\n}\n\nreturn [{ json: { error: false, nombre: nombre } }];"
      },
