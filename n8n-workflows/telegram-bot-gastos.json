    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/api/gastos/mensuales",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Token", "value": "={{ $env.API_TOKEN }}" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "http-ver",
      "name": "API - Ver Gastos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -100]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\nconst gastos = data.gastos;\n\nlet msg = `📋 *Gastos ${data.mes}/${data.anio}*\\n`;\nmsg += `💰 Total: $${data.total} | ✅ Pagado: $${data.pagado} | ⏳ Pendiente: $${data.pendiente}\\n\\n`;\n\nfor (const g of gastos) {\n  const estado = g.pagado ? '✅' : '⬜';\n  const monto = g.monto ? `$${g.monto}` : 'S/M';\n  msg += `${estado} *${g.servicio}* - Día ${g.dia_pago} - ${monto}\\n`;\n}\n\nreturn [{ json: { text: msg } }];"
      },
      "id": "format-ver",
      "name": "Formatear Lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/api/gastos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Token", "value": "={{ $env.API_TOKEN }}" },
            { "name": "Accept", "value": "application/json" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "servicio", "value": "={{ $json.servicio }}" },
            { "name": "dia_pago", "value": "={{ $json.dia_pago }}" },
            { "name": "monto", "value": "={{ $json.monto }}" }
          ]
        },
        "options": {}
      },
      "id": "http-agregar",
      "name": "API - Agregar Gasto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 50]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.text;\n// Formato: /agregar Servicio,dia,monto\nconst parts = text.replace('/agregar ', '').split(',');\n\nif (parts.length < 2) {\n  return [{ json: { error: true, text: '❌ Formato incorrecto.\\nUsa: /agregar Servicio,dia,monto\\nEjemplo: /agregar Netflix,10,14.00' } }];\n}\n\nreturn [{ json: {\n  error: false,\n  servicio: parts[0].trim(),\n  dia_pago: parseInt(parts[1].trim()),\n  monto: parts[2] ? parseFloat(parts[2].trim()) : null\n} }];"
      },
      "id": "parse-agregar",
      "name": "Parsear Agregar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 50]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message.text;\n// Formato: /quitar NombreServicio\nconst nombre = text.replace('/quitar ', '').trim();\n\nif (!nombre) {\n  return [{ json: { error: true, text: '❌ Indica el nombre del servicio.\\nUsa: /quitar Netflix' } }];\n}\n\nreturn [{ json: { error: false, nombre: nombre } }];"
      },
      "id": "parse-quitar",
      "name": "Parsear Quitar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/api/gastos/buscar?nombre={{ encodeURIComponent($json.nombre) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Token", "value": "={{ $env.API_TOKEN }}" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "http-buscar-quitar",
      "name": "API - Buscar para Quitar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 200]
    },
